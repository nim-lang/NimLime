%YAML 1.2
---
# http://www.sublimetext.com/docs/syntax.html
version: 2
name: NIF
file_extensions:
  - nif
scope: source.nif
contexts:
  # Rule: comment
  comment|0:
    - meta_content_scope: comment.line.number-sign.nif
    - match: '#'
      scope: punctuation.definition.comment.begin.nif
      push: comment|1
      pop: true
    - match: '(?=\S)'
      pop: true
  comment|0|entry-0:
    - match: ''
      set: comment|0
  # Rule: comment
  comment|1:
    - meta_content_scope: comment.line.number-sign.nif
    - match: '#'
      scope: comment.line.number-sign.nif punctuation.definition.comment.end.nif
      pop: true
  # Rule: filename
  filename|0:
    - match: ','
      push: filename|1
      pop: true
    - match: '(?=\S)'
      pop: true
  # Rule: filename
  filename|1:
    - match: '(?:\\[0-9A-F][0-9A-F]|[ -~&&[^()\[\]{}~#''"\\:]])'
    - match: ''
      pop: true
  # Rule: group
  group|0:
    - meta_content_scope: meta.group.nif
    - match: '(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d|\.)*)|(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d)*)'
      scope: variable.function.nif
      push: group|1
      pop: true
    - match: '\.(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d)*'
      scope: keyword.nif
      push: group|1
      pop: true
    - match: '\S'
      scope: invalid.illegal.nif
      pop: true
  # Rule: group
  group|1:
    - meta_content_scope: meta.group.nif
    - match: '(?:,(~)?(\d+))|(?:(~)?(\d+))(?:,(~)?(\d+))?'
      captures:
        1: keyword.operator.nif
        2: constant.numeric.nif
        3: keyword.operator.nif
        4: constant.numeric.nif
        5: keyword.operator.nif
        6: constant.numeric.nif
      push: [node|0, comment|0|entry-0, filename|0]
    - match: '#'
      scope: comment.line.number-sign.nif punctuation.definition.comment.begin.nif
      push: [node|0, comment|1]
    - match: '\.'
      scope: keyword.nif
    - match: '(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d|\.)*'
    - match: '[+-]\d+(?:(?:(?:\.\d+)?(E-?\d+)?)|u)?'
      scope: meta.number.nif constant.numeric.nif
    - match: '[-=\+\*/<>\$~&%\|!\?\^\.∙∘×★⊗⊘⊙⊛⊠⊡∩∧⊓±⊕⊖⊞⊟∪∨⊔]+'
    - match: '(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d)*'
    - match: ':(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d|\.)*'
      scope: entity.name.variable.nif
    - match: '''(?:(\\[0-9A-F][0-9A-F])|[ -~&&[^()\[\]{}~#''"\\:]])'''
      scope: constant.character.nif
      captures:
        1: constant.character.escape.nif
    - match: '"'
      scope: meta.string.nif string.quoted.double.nif punctuation.definition.string.begin.nif
      push: string-literal-inner|0
    - match: '\('
      scope: meta.group.nif punctuation.definition.group.begin.nif
      push: group|0
    - match: '\)'
      scope: meta.group.nif punctuation.definition.group.end.nif
      pop: true
    - match: '\S'
      scope: invalid.illegal.nif
      pop: true
  # Rule: main
  main:
    - match: '(?:,(~)?(\d+))|(?:(~)?(\d+))(?:,(~)?(\d+))?'
      captures:
        1: keyword.operator.nif
        2: constant.numeric.nif
        3: keyword.operator.nif
        4: constant.numeric.nif
        5: keyword.operator.nif
        6: constant.numeric.nif
      push: [node|0, comment|0|entry-0, filename|0]
    - match: '#'
      scope: comment.line.number-sign.nif punctuation.definition.comment.begin.nif
      push: [node|0, comment|1]
    - match: '\.'
      scope: keyword.nif
    - match: '(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d|\.)*'
    - match: '[+-]\d+(?:(?:(?:\.\d+)?(E-?\d+)?)|u)?'
      scope: meta.number.nif constant.numeric.nif
    - match: '[-=\+\*/<>\$~&%\|!\?\^\.∙∘×★⊗⊘⊙⊛⊠⊡∩∧⊓±⊕⊖⊞⊟∪∨⊔]+'
    - match: '(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d)*'
    - match: ':(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d|\.)*'
      scope: entity.name.variable.nif
    - match: '''(?:(\\[0-9A-F][0-9A-F])|[ -~&&[^()\[\]{}~#''"\\:]])'''
      scope: constant.character.nif
      captures:
        1: constant.character.escape.nif
    - match: '"'
      scope: meta.string.nif string.quoted.double.nif punctuation.definition.string.begin.nif
      push: string-literal-inner|0
    - match: '\('
      scope: meta.group.nif punctuation.definition.group.begin.nif
      push: group|0
    - match: '(?=\S)'
      pop: true
  # Rule: node
  node|0:
    - match: '\.'
      scope: keyword.nif
      pop: true
    - match: '(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d|\.)*'
      pop: true
    - match: '[+-]\d+(?:(?:(?:\.\d+)?(E-?\d+)?)|u)?'
      scope: meta.number.nif constant.numeric.nif
      pop: true
    - match: '[-=\+\*/<>\$~&%\|!\?\^\.∙∘×★⊗⊘⊙⊛⊠⊡∩∧⊓±⊕⊖⊞⊟∪∨⊔]+'
      pop: true
    - match: '(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d)*'
      pop: true
    - match: ':(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])(?:(?:[`\p{L}_]|\\[0-9A-F][0-9A-F])|\d|\.)*'
      scope: entity.name.variable.nif
      pop: true
    - match: '''(?:(\\[0-9A-F][0-9A-F])|[ -~&&[^()\[\]{}~#''"\\:]])'''
      scope: constant.character.nif
      captures:
        1: constant.character.escape.nif
      pop: true
    - match: '"'
      scope: meta.string.nif string.quoted.double.nif punctuation.definition.string.begin.nif
      push: string-literal-inner|0
      pop: true
    - match: '\('
      scope: meta.group.nif punctuation.definition.group.begin.nif
      push: group|0
      pop: true
    - match: '\S'
      scope: invalid.illegal.nif
      pop: true
  # Rule: string-literal-inner
  string-literal-inner|0:
    - meta_content_scope: meta.string.nif string.quoted.double.nif
    - match: '\\[0-9A-F][0-9A-F]'
      scope: constant.character.escape.nif
    - match: '"'
      scope: meta.string.nif string.quoted.double.nif punctuation.definition.string.end.nif
      pop: true
