# -*- mode: ebnf; -*-
EXTENSIONS = 'nif'
SCOPE = 'source.nif'

CONTROL_CHARS = `()[]{}~#'"\:@`
B62DIGIT = '[0-9A-Za-z]'
SHORTCHAR = '[ntr|^]'
HEXCHAR = '[0-9A-F]'
ESCAPE = '\\(?:#[HEXCHAR]#[HEXCHAR]|#[SHORTCHAR])'
STR_END = '[\s()@~#]'
EMPTY = `.`
IDENTIFIER_START = '(?:[_A-Za-z\x80-\xFF]|(#[ESCAPE]))'
IDENTIFIER_CHAR = '#[IDENTIFIER_START]|\d'
IDENTIFIER = '#[IDENTIFIER_START](?:#[IDENTIFIER_CHAR])*'
SYMBOL = '#[IDENTIFIER_START](?:#[IDENTIFIER_CHAR]|\.)*'
SYMBOL_DEF = ':#[SYMBOL]'
DEC_DIGIT  = '\d'
HEX_DIGIT  = '[0-9A-Fa-f]'
OCT_DIGIT  = '[0-7]'
BIN_DIGIT  = '[0-1]'
DIGITS[digit]  = '#[digit](?:_?#[digit])*'
DEC_DIGITS = DIGITS[DEC_DIGIT]
HEX_DIGITS = DIGITS[HEX_DIGIT]
OCT_DIGITS = DIGITS[OCT_DIGIT]
BIN_DIGITS = DIGITS[BIN_DIGIT]
INT_PART   = '(?:0x#[HEX_DIGITS]|0o#[OCT_DIGITS]|0b#[BIN_DIGITS]|#[DEC_DIGITS])'
EXPONENT   = 'E[-+]?#[DEC_DIGITS]'
FLOAT_PART = '(?:\.#[DEC_DIGITS](?:#[EXPONENT])?|#[EXPONENT])'
NUMBER     = '-?(?:#[DEC_DIGITS]#[FLOAT_PART]|#[INT_PART]u?)\b'
VISIBLE_CHARACTER = '[ -\xFF&&[^#[CONTROL_CHARS]]]'
ILLEGAL_CHARS[chars] = '[\x00-\x1F#[CONTROL_CHARS]&&[^\s#[chars]]]'
ILLEGAL_CHARS = ILLEGAL_CHARS['']
CHAR_LITERAL = '\'(?:(#[ESCAPE])|#[VISIBLE_CHARACTER])\''

main: line-node | compound-node;

line-node: tag-head node* '\n';

node: atom | compound-node;

suffix: ~line-info ~comment ;

atom:
  (
    EMPTY{constant.language}
  | SYMBOL_DEF{entity.name.variable}
  | auto-string
  | SYMBOL
  | NUMBER{meta.number constant.numeric}
  | CHAR_LITERAL{0: constant.character, 1: constant.character.escape}
  | string-literal
  )
   suffix
;

tag-head: node-kind suffix;

compound-node{meta.group}:
  `(`{punctuation.definition.group.begin}
  tag-head (~node | '[^\s\)]'{invalid.illegal})*
  ~`)`{punctuation.definition.group.end}
;

filename:
  ','
  (~ESCAPE)*
  ~'(?=#[ILLEGAL_CHARS]|\s)'
  | ''
;

line-info{comment.line}:
  '(?:@~?|~)#[B62DIGIT]+,~?#[B62DIGIT]+|(?:@,?~?|~)#[B62DIGIT]+'
    ~filename
  | ''
;

comment{comment.line}:
  `#`
  (~ILLEGAL_CHARS['#']{invalid.illegal})*
  ~'#'
  | ''
;

node-kind:
  '(?:#[SYMBOL])'{variable.function} |
  '\.#[IDENTIFIER]'{keyword.other.directive}
;

string-literal{meta.string string.quoted.double}:
  `"`{punctuation.definition.string.begin}
  (~(ESCAPE{constant.character.escape}
  | ILLEGAL_CHARS['"#:']{invalid.illegal}))*
  ~'"'{punctuation.definition.string.end}
;

auto-string{meta.string string.unquoted}:
  '(?:#[NUMBER]|#[SYMBOL])[-/:]|[/:]'{
    1: constant.character.escape,
    2: constant.character.escape
  }
  (~ESCAPE{constant.character.escape})*
  ~'(?=#[STR_END])'
;
