%YAML 1.2
---
# http://www.sublimetext.com/docs/syntax.html
version: 2
name: NIF
file_extensions:
  - nif
scope: source.nif
contexts:
  # Rule: auto-string
  auto-string|0:
    - meta_content_scope: meta.string.nif string.unquoted.nif
    - match: '\\(?:[0-9A-F][0-9A-F]|[ntr|^])'
      scope: constant.character.escape.nif
    - match: '(?=[\s()@~#])'
      scope: meta.string.nif string.unquoted.nif
      pop: true
  # Rule: comment
  comment|0:
    - meta_content_scope: comment.line.nif
    - match: '#'
      push: comment|1
      pop: true
    - match: ''
      scope: comment.line.nif
      pop: true
  comment|0|entry-0:
    - match: ''
      set: comment|0
  # Rule: comment
  comment|1:
    - meta_content_scope: comment.line.nif
    - match: '[\x00-\x1F\(\)\[\]\{\}~#''"\\:@&&[^\s#]]'
      scope: invalid.illegal.nif
    - match: '#'
      scope: comment.line.nif
      pop: true
  # Rule: compound-node
  compound-node|0:
    - meta_content_scope: meta.group.nif
    - match: '(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))|\d|\.)*)'
      scope: variable.function.nif
      push: [compound-node|1|entry-0, suffix|0]
      pop: true
    - match: '\.(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))|\d)*'
      scope: keyword.other.directive.nif
      push: [compound-node|1|entry-0, suffix|0]
      pop: true
    - match: '\S'
      scope: invalid.illegal.nif
      pop: true
  # Rule: compound-node
  compound-node|1:
    - meta_content_scope: meta.group.nif
    - match: '\.'
      scope: constant.language.nif
      push: suffix|0
    - match: ':(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))|\d|\.)*'
      scope: entity.name.variable.nif
      push: suffix|0
    - match: '(?:-?(?:\d(?:_?\d)*(?:\.\d(?:_?\d)*(?:E[-+]?\d(?:_?\d)*)?|E[-+]?\d(?:_?\d)*)|(?:0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0o[0-7](?:_?[0-7])*|0b[0-1](?:_?[0-1])*|\d(?:_?\d)*)u?)\b|(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))|\d|\.)*)[-/:]|[/:]'
      scope: meta.string.nif string.unquoted.nif
      captures:
        1: constant.character.escape.nif
        2: constant.character.escape.nif
      push: [suffix|0, auto-string|0]
    - match: '(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))|\d|\.)*'
      push: suffix|0
    - match: '-?(?:\d(?:_?\d)*(?:\.\d(?:_?\d)*(?:E[-+]?\d(?:_?\d)*)?|E[-+]?\d(?:_?\d)*)|(?:0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0o[0-7](?:_?[0-7])*|0b[0-1](?:_?[0-1])*|\d(?:_?\d)*)u?)\b'
      scope: meta.number.nif constant.numeric.nif
      push: suffix|0
    - match: '''(?:(\\(?:[0-9A-F][0-9A-F]|[ntr|^]))|[ -\xFF&&[^\(\)\[\]\{\}~#''"\\:@]])'''
      captures:
        0: constant.character.nif
        1: constant.character.escape.nif
      push: suffix|0
    - match: '"'
      scope: meta.string.nif string.quoted.double.nif punctuation.definition.string.begin.nif
      push: [suffix|0, string-literal|0]
    - match: '\('
      scope: meta.group.nif punctuation.definition.group.begin.nif
      push: compound-node|0
    - match: '[^\s\)]'
      scope: invalid.illegal.nif
    - match: '\)'
      scope: meta.group.nif punctuation.definition.group.end.nif
      pop: true
  compound-node|1|entry-0:
    - match: ''
      set: compound-node|1
  # Rule: filename
  filename|0:
    - match: ','
      push: filename|1
      pop: true
    - match: ''
      pop: true
  # Rule: filename
  filename|1:
    - match: '\\(?:[0-9A-F][0-9A-F]|[ntr|^])'
    - match: '(?=[\x00-\x1F\(\)\[\]\{\}~#''"\\:@&&[^\s]]|\s)'
      pop: true
  # Meta scope context for line-info
  line-info|meta:
    - meta_content_scope: comment.line.nif
    - match: ''
      pop: true
  # Rule: line-node
  line-node|0:
    - match: '\.'
      scope: constant.language.nif
      push: suffix|0
    - match: ':(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))|\d|\.)*'
      scope: entity.name.variable.nif
      push: suffix|0
    - match: '(?:-?(?:\d(?:_?\d)*(?:\.\d(?:_?\d)*(?:E[-+]?\d(?:_?\d)*)?|E[-+]?\d(?:_?\d)*)|(?:0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0o[0-7](?:_?[0-7])*|0b[0-1](?:_?[0-1])*|\d(?:_?\d)*)u?)\b|(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))|\d|\.)*)[-/:]|[/:]'
      scope: meta.string.nif string.unquoted.nif
      captures:
        1: constant.character.escape.nif
        2: constant.character.escape.nif
      push: [suffix|0, auto-string|0]
    - match: '(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))|\d|\.)*'
      push: suffix|0
    - match: '-?(?:\d(?:_?\d)*(?:\.\d(?:_?\d)*(?:E[-+]?\d(?:_?\d)*)?|E[-+]?\d(?:_?\d)*)|(?:0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0o[0-7](?:_?[0-7])*|0b[0-1](?:_?[0-1])*|\d(?:_?\d)*)u?)\b'
      scope: meta.number.nif constant.numeric.nif
      push: suffix|0
    - match: '''(?:(\\(?:[0-9A-F][0-9A-F]|[ntr|^]))|[ -\xFF&&[^\(\)\[\]\{\}~#''"\\:@]])'''
      captures:
        0: constant.character.nif
        1: constant.character.escape.nif
      push: suffix|0
    - match: '"'
      scope: meta.string.nif string.quoted.double.nif punctuation.definition.string.begin.nif
      push: [suffix|0, string-literal|0]
    - match: '\('
      scope: meta.group.nif punctuation.definition.group.begin.nif
      push: compound-node|0
    - match: '\S'
      scope: invalid.illegal.nif
    - match: '\n'
      pop: true
  # Rule: main
  main:
    - match: '(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))|\d|\.)*)'
      scope: variable.function.nif
      push: [line-node|0, suffix|0]
      pop: true
    - match: '\.(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))(?:(?:[_A-Za-z\x80-\xFF]|(\\(?:[0-9A-F][0-9A-F]|[ntr|^])))|\d)*'
      scope: keyword.other.directive.nif
      push: [line-node|0, suffix|0]
      pop: true
    - match: '\('
      scope: meta.group.nif punctuation.definition.group.begin.nif
      push: compound-node|0
      pop: true
    - match: '\S'
      scope: invalid.illegal.nif
      pop: true
  # Rule: string-literal
  string-literal|0:
    - meta_content_scope: meta.string.nif string.quoted.double.nif
    - match: '\\(?:[0-9A-F][0-9A-F]|[ntr|^])'
      scope: constant.character.escape.nif
    - match: '[\x00-\x1F\(\)\[\]\{\}~#''"\\:@&&[^\s"#:]]'
      scope: invalid.illegal.nif
    - match: '"'
      scope: meta.string.nif string.quoted.double.nif punctuation.definition.string.end.nif
      pop: true
  # Rule: suffix
  suffix|0:
    - match: '(?:@~?|~)[0-9A-Za-z]+,~?[0-9A-Za-z]+|(?:@,?~?|~)[0-9A-Za-z]+'
      scope: comment.line.nif
      push: [comment|0|entry-0, line-info|meta, filename|0]
      pop: true
    - match: ''
      scope: comment.line.nif
      push: comment|0
      pop: true
